      "targets": [{"editorMode": "code", "expr": "100 * sum(rate(http_requests_total{status=~\"5..\",handler!=\"none\"}[5m])) / clamp_min(sum(rate(http_requests_total{handler!=\"none\"}[5m])), 0.000001)", "instant": false, "legendFormat": "5xx", "range": true, "refId": "A"}],
      "title": "Ошибки 5xx",
      "type": "stat"
    },
    {
